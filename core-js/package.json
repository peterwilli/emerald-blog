{
  "name": "@emerald-show/core-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "source": "src/index.js",
  "main": "../public/emerald-core.js",
  "scripts": {
    "build": "parcel build --no-cache src/index.js",
    "watch": "parcel watch src/index.js --dist-dir ../public"
  },
  "dependencies": {
    "@emerald-show/emerald-background": "workspace:*"
  },
  "devDependencies": {
    "@parcel/core": "2.15.2",
    "@parcel/reporter-bundle-analyzer": "2.15.2",
    "@parcel/reporter-bundle-buddy": "2.15.2",
    "parcel": "2.15.2"
  },
  "targets": {
    "main": {
      "optimize": true,
      "includeNodeModules": true,
      "sourceMap": false
    }
  }
}
